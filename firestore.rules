rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /class-player/{doc} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['v','t'])
                   && request.resource.data.v is string
                   && request.resource.data.v.size() < 900000;
    }
  }
}
